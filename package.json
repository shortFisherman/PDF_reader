{
  "name": "pdf_reader",
  "version": "1.0.0",
  "description": "用于阅读英文教材和论文的本地双语 PDF 翻译阅读器。",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "test": "npm run test:frontend",
    "lint:js": "eslint .",
    "test:frontend": "npm run test:ui-copy && npm run test:error-safety && npm run test:translation-ui && npm run test:translator && npm run test:zoom && node tests/run-alignment-controller-tests.mjs",
    "test:translation-ui": "node tests/run-translation-ui-tests.mjs",
    "test:error-safety": "node tests/run-error-safety-tests.mjs",
    "test:ui-copy": "node tests/run-ui-copy-tests.mjs",
    "test:translator": "node tests/run-translator-tests.mjs",
    "test:zoom": "node tests/run-zoom-tests.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1"
  }
}
