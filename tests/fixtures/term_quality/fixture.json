    {
      "id": "medical-guideline-ad-tcs",
      "category": "medical_guideline",
      "title": "特应性皮炎与 TCS 指南节选",
      "pages": [
        {
          "page": 1,
          "text": "Atopic dermatitis (AD) is a chronic inflammatory skin disease. Topical corticosteroids (TCS) remain first-line therapy for AD flares. Benefits, cost, and patient education are important considerations in treatment decisions. Adherence to therapy affects outcomes; adverse events and the shadow of under-treatment are common concerns."
        },
        {
          "page": 2,
          "text": "The guideline recommends topical corticosteroids for acute AD. TCS are preferred over systemic agents. Using TCS for a short course avoids confusion and burden."
        }
      ],
      "golden": {
        "core_terms": [
          {
            "source": "AD",
            "forms": ["AD", "Atopic dermatitis", "atopic dermatitis"],
            "expected_target": "特应性皮炎",
            "pages": [1, 2]
          },
          {
            "source": "TCS",
            "forms": ["TCS", "topical corticosteroids", "topical corticosteroid"],
            "expected_target": "外用糖皮质激素",
            "pages": [1, 2]
          },
          {
            "source": "adherence",
            "forms": ["adherence"],
            "expected_target": "依从性",
            "pages": [1]
          },
          {
            "source": "systemic agents",
            "forms": ["systemic agents"],
            "expected_target": "全身性用药",
            "pages": [2]
          }
        ],
        "common_words": ["benefits", "cost", "education", "confusion", "burden"]
      }
    },
    {
      "id": "technical-paper-contrastive",
      "category": "technical_paper",
      "title": "对比学习技术论文节选",
      "pages": [
        {
          "page": 1,
          "text": "Self-attention computes attention weights for every pair of tokens. Multimodal alignment improves retrieval results. Our analysis focuses on the role of the learning rate schedule in contrastive learning."
        },
        {
          "page": 2,
          "text": "The learning rate schedule is tuned before evaluation. Contrastive learning benefits from a well-chosen temperature. Our study reports mean results for the temperature value; data and analysis are available."
        }
      ],
      "golden": {
